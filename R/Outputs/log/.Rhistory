P <- covar
B <- dimor_norm
e <- rnorm(length(sd), sd = error)
B_err <- B + e
evolv_error <- as.numeric(
t(B_err) %*% P %*% B_err /
(t(B_err) %*% B_err)
)
#
results[[counter]] <- data.frame(
Species = sp,
Sexual_Dimorphism = norma(sd),
Evolvability = evolv_normal,
Error_Evolvability = evolv_error,
Sigma_Value = error,
check.names = FALSE
)
counter <- counter + 1
}
}
