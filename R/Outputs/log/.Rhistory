dplyr::filter(Eigenvector >= 1, Eigenvector <= 38) %>%
dplyr::group_by(Species) %>%
dplyr::summarise(
Mean_Evolvability = mean(Evolvability, na.rm = TRUE),
Mean_Conditional_Evolvability = mean(Conditional_Evolvability, na.rm = TRUE),
.groups = "drop"
)
View(results_sd)
