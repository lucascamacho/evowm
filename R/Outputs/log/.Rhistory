p3
p3 <- ggplot() +
geom_segment(
data = error_long,
aes(
x = Dimorfism,
xend = Dimorfism,
y = Mean_Evolvability,
yend = Evolvability_value
),
alpha = 0.1
) +
geom_point(
data = plot_e,
aes(
x = Dimorfism,
y = Value,
shape = Type,
color = Type
),
size = 6,
alpha = 0.9
) +
geom_smooth(
data = subset(plot_e,
Type == "Sexual Dimorphism Evolvability"),
aes(
x = Dimorfism,
y = Value
),
method = "lm",
se = FALSE
) +
labs(
x = "Sexual Dimorphism",
y = "Evolvability"
) +
theme_classic(base_size = 14) +
theme(
plot.title = element_text(size = 28, face = "bold", hjust = 0.5, margin = margin(b = 20)),
axis.title = element_text(size = 28, face = "bold"),
axis.text = element_text(
size = 24,
face = "bold",
colour = "black"
),
legend.title = element_text(size = 24, face = "bold"),
legend.text = element_text(size = 24, face = "bold")
)
