na.value = "white"
) +
coord_equal() +
theme_classic(
base_size = 14
) +
theme(
axis.text.x = element_text(
angle = 90,
hjust = 1,
vjust = 0.5
)
) +
labs(
x = "Eigenvectors of mean P",
y = "Eigenvectors of mean P",
fill = "Correlation"
)
# Display
p5
# ============================================================
# Figure 4
# Variance and conditional variance correlations
# ============================================================
library(ggplot2)
# ============================================================
# 1. Make sure all P matrices are matrices
# ============================================================
vcv <- lapply(vcv, as.matrix)
# ============================================================
# 2. Calculate the mean P matrix
# ============================================================
P_mean <- Reduce(
"+",
vcv
) / length(vcv)
# ============================================================
# 3. Eigen-decomposition of the mean P matrix
# ============================================================
eig_P_mean <- eigen(
P_mean,
symmetric = TRUE
)
# Common eigenvectors
G <- eig_P_mean$vectors
# Eigenvalues of mean P
lambda_P_mean <- eig_P_mean$values
# ============================================================
# 4. Calculate unconditional variance (e)
#
# e = g' P g
# ============================================================
e_values <- sapply(
names(vcv),
function(sp) {
P <- vcv[[sp]]
diag(
t(G) %*%
P %*%
G
)
}
)
# ============================================================
# 5. Calculate conditional variance (c)
#
# c = 1 / (g' P^-1 g)
# ============================================================
c_values <- sapply(
names(vcv),
function(sp) {
P <- vcv[[sp]]
P_inv <- solve(P)
1 / diag(
t(G) %*%
P_inv %*%
G
)
}
)
# ============================================================
# 6. Organize e and c
#
# Rows    = genera
# Columns = eigenvectors
# ============================================================
e_values <- t(e_values)
c_values <- t(c_values)
rownames(e_values) <- names(vcv)
rownames(c_values) <- names(vcv)
colnames(e_values) <- paste0("PC", 1:39)
colnames(c_values) <- paste0("PC", 1:39)
# Check dimensions
dim(e_values)
dim(c_values)
# ============================================================
# 7. Correlations among unconditional variances
# ============================================================
cor_e <- cor(
e_values,
method = "pearson"
)
# ============================================================
# 8. Correlations among conditional variances
# ============================================================
cor_c <- cor(
c_values,
method = "pearson"
)
# ============================================================
# 9. Create matrix for plotting
#
# Visual orientation:
#
#             X
#       PC39 -------- PC1
#
# Y PC1       c c c c  1
#   PC2       e c c c  c
#   PC3       e e c c  c
#   ...       ...
#   PC39      e e e e  c
#
# bottom-left = e
# top-right    = c
# diagonal     = 1
# ============================================================
plot_matrix <- matrix(
NA,
nrow = 39,
ncol = 39
)
# ------------------------------------------------------------
# Important:
# We will reverse the X axis later.
# Therefore, construct the matrix in the normal orientation:
#
# lower triangle = e
# upper triangle = c
# diagonal = 1
# ------------------------------------------------------------
plot_matrix[lower.tri(plot_matrix)] <-
cor_e[lower.tri(cor_e)]
plot_matrix[upper.tri(plot_matrix)] <-
cor_c[upper.tri(cor_c)]
diag(plot_matrix) <- 1
# ============================================================
# 10. Convert matrix to long format
# ============================================================
heatmap_data <- as.data.frame(
as.table(plot_matrix)
)
colnames(heatmap_data) <- c(
"Y",
"X",
"Correlation"
)
# ============================================================
# 11. Define axis order
# ============================================================
# Y axis:
# PC1 at top → PC39 at bottom
heatmap_data$Y <- factor(
heatmap_data$Y,
levels = paste0("PC", 39:1)
)
# X axis:
# PC39 on left → PC1 on right
heatmap_data$X <- factor(
heatmap_data$X,
levels = paste0("PC", 1:39)
)
# ============================================================
# 12. Plot Figure 4
# ============================================================
p5 <- ggplot(
heatmap_data,
aes(
x = X,
y = Y,
fill = Correlation
)
) +
geom_tile() +
scale_fill_gradient2(
low = "blue",
mid = "white",
high = "red",
midpoint = 0,
limits = c(-1, 1),
na.value = "white"
) +
coord_equal() +
theme_classic(
base_size = 14
) +
theme(
axis.text.x = element_text(
angle = 90,
hjust = 1,
vjust = 0.5
)
) +
labs(
x = "Eigenvectors of mean P",
y = "Eigenvectors of mean P",
fill = "Correlation"
)
# Display
p5
p5
heatmap_data
