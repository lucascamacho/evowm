msrs_catarrhini$SEX[msrs_catarrhini$SEX == ""] = NA
msrs_catarrhini$SEX[msrs_catarrhini$SEX == "sexo"] = NA
msrs_catarrhini = msrs_catarrhini[complete.cases(msrs_catarrhini$SEX), ]
setwd("~/Dropbox/Doc/Code/evowm/R/Novo_Output/p_vcv_gabriel/catarrhini")
temp = list.files(pattern = "*.csv")
vcv = lapply(temp, read.csv, header = FALSE, dec = ",")
names(vcv)  = gsub(".csv", replacement = "", temp)
cov.matrices_m = list()
cov.matrices_f = list()
for(i in 1:length(names(vcv))){
#
genus = str_split_1(names(vcv)[[i]], "_")[1]
sp = str_split_1(names(vcv)[[i]], "_")[2]
#
species_subset = msrs_catarrhini[which(msrs_catarrhini$GENUS == genus), ]
species_subset = species_subset[which(species_subset$SPECIES == sp), ]
# separate M and F
sub_sexes_m = species_subset[which(species_subset$SEX == "male"), ]
sub_sexes_f = species_subset[which(species_subset$SEX == "female"), ]
if(nrow(sub_sexes_m) < 40 && nrow(sub_sexes_f) < 40){
next
}
else{
cov.matrices_m[[i]] = cov(as.matrix(sub_sexes_m[,49:87]))
cov.matrices_f[[i]] = cov(as.matrix(sub_sexes_f[,49:87]))
}
}
species = names(vcv)
catarrhini = list(species, cov.matrices_f, cov.matrices_m)
##### Platyrrhini ######
msrs_platyrrhini = read.csv(file = "~/Dropbox/Doc/Data/primates_measures/medidas_platyrrhini.csv", dec = ",", sep = ",")
#
index <- which(apply(msrs_platyrrhini[, 23:61], 1, function(x) any(is.na(x) | (x == "" & !is.numeric(x)))))
msrs_platyrrhini <- msrs_platyrrhini[-index, ]
# remove uncertain sex
msrs_platyrrhini$SEX4.[msrs_platyrrhini$SEX4. == ""] = NA
msrs_platyrrhini$SEX4.[msrs_platyrrhini$SEX4. == " "] = NA
msrs_platyrrhini = msrs_platyrrhini[complete.cases(msrs_platyrrhini$SEX4.), ]
setwd("~/Dropbox/Doc/Code/evowm/R/Novo_Output/p_vcv_gabriel/")
temp = list.files(pattern = "*.csv")
vcv = lapply(temp, read.csv, header = FALSE, dec = ",")
names(vcv)  = gsub(".csv", replacement = "", temp)
cov.matrices_m = list()
cov.matrices_f = list()
for(i in 1:length(names(vcv))){
# choose species i
genus = str_split_1(names(vcv)[[i]], "_")[1]
sp = str_split_1(names(vcv)[[i]], "_")[2]
species_subset = msrs_platyrrhini[which(msrs_platyrrhini$GENUS. == genus), ]
species_subset = species_subset[which(species_subset$SPECIES. == sp), ]
# separate M and F
sub_sexes_m = species_subset[which(species_subset$SEX4. == "M"), ]
sub_sexes_f = species_subset[which(species_subset$SEX4. == "F"), ]
if(nrow(sub_sexes_m) < 40 && nrow(sub_sexes_f) < 40){
next
}
else{
sub_sexes_m[, 23:61] <- lapply(sub_sexes_m[, 23:61], function(x) as.numeric(as.character(x)))
sub_sexes_m <- sub_sexes_m[complete.cases(sub_sexes_m[, 23:61]), ]
sub_sexes_f[, 23:61] <- lapply(sub_sexes_f[, 23:61], function(x) as.numeric(as.character(x)))
sub_sexes_f <- sub_sexes_f[complete.cases(sub_sexes_f[, 23:61]), ]
if(nrow(sub_sexes_m) < 40 && nrow(sub_sexes_f) < 40){
next
}
else{
cov.matrices_m[[i]] = cov(sub_sexes_m[,23:61])
cov.matrices_f[[i]] = cov(sub_sexes_f[,23:61])
}
}
}
species = names(vcv)
platyrrhini = list(species, cov.matrices_f, cov.matrices_m)
View(platyrrhini)
