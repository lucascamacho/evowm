# Nomascus leucogenys
leuco = msrs[which(msrs$SPECIES == "leucogenys"),]
leuco = leuco[-which(leuco$SEX == "?female"),]
# grupo irmao
gab = msrs[which(msrs$SPECIES == "gabriellae"),]
leuco = rbind(leuco, gab)
fit = manova(as.matrix(leuco[,50:88]) ~ leuco$SEX + leuco$SPECIES +
leuco$SEX:leuco$SPECIES)
summary(fit, test = "Wilks")
fit = manova(as.matrix(leuco[,50:88]) ~ leuco$SEX + leuco$SPECIES)
summary(fit, test = "Wilks")
cov.matrix = CalculateMatrix(fit)
write.table(cov.matrix, file = "~/Dropbox/Doc/Output/nolog_vcv/Nomascus_leucogenys.txt", col.names = NA)
