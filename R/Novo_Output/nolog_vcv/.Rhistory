# Definindo um vetor e uma matriz contendo 4 matrizes
vetor <- c(1, 2, 3)
matriz <- array(data = c(1:12, 13:24, 25:36, 37:48), dim = c(3, 4, 4))
# Função para multiplicar o vetor por uma matriz
mult_por_matriz <- function(vetor, matriz) {
resultado <- sapply(1:dim(matriz)[3], function(i) matriz[, , i] %*% vetor)
return(resultado)
}
# Multiplicando o vetor pela matriz contendo 4 matrizes
resultado <- mult_por_matriz(vetor, matriz)
# Definindo um vetor e uma matriz contendo 4 matrizes
vetor <- c(1, 2, 3)
matriz <- array(data = c(1:12, 13:24, 25:36, 37:48), dim = c(3, 4, 4))
# Função para multiplicar o vetor por uma matriz
mult_por_matriz <- function(vetor, matriz) {
resultado <- array(0, dim = c(dim(matriz)[1], dim(matriz)[3]))
for (i in 1:dim(matriz)[3]) {
resultado[,i] <- matriz[,,i] %*% vetor
}
return(resultado)
}
# Multiplicando o vetor pela matriz contendo 4 matrizes
resultado <- mult_por_matriz(vetor, matriz)
