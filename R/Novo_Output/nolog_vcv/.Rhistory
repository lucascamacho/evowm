avu = msrs[which(msrs$SPECIES == "avunculus"),]
fit = manova(as.matrix(roxe[,50:88]) ~ roxe$SEX + roxe$SPECIES)
roxe = rbind(roxe, avu)
fit = manova(as.matrix(roxe[,50:88]) ~ roxe$SEX + roxe$SPECIES)
summary(fit, test = "Wilks")
cov.matrix = CalculateMatrix(fit)
write.table(cov.matrix, file = "~/Dropbox/Doc/Output/nolog_vcv/Rhinopithecus_roxellana.txt", col.names = NA)
# Semnopithecus hector
hec = msrs[which(msrs$SPECIES == "hector"),]
# grupo irmao
ente = msrs[which(msrs$SPECIES == "entellus"),]
# Semnopithecus hector
hec = msrs[which(msrs$SPECIES == "hector"),]
# grupo irmao
ente = msrs[which(msrs$SPECIES == "entellus"),]
hec = rbind(hec, ente)
fit = manova(as.matrix(hec[,50:88]) ~ hec$SEX + hec$SPECIES +
hec$SEX:hec$SPECIES)
summary(fit, test = "Wilks")
fit = manova(as.matrix(hec[,50:88]) ~ hec$SEX + hec$SPECIES)
summary(fit, test = "Wilks")
cov.matrix = CalculateMatrix(fit)
write.table(cov.matrix, file = "~/Dropbox/Doc/Output/nolog_vcv/Semnopithecus_hector.txt", col.names = NA)
# Trachypithecus francoisi
fran = msrs[which(msrs$SPECIES == "francoisi"),]
# Trachypithecus germaini
ger = msrs[which(msrs$SPECIES == "germaini"),]
# grupo irmao
aura = msrs[which(msrs$SPECIES == "auratus"),]
ger = rbind(ger, aura)
fit = manova(as.matrix(ger[,50:88]) ~ ger$SEX + ger$SPECIES +
ger$SEX:ger$SPECIES)
summary(fit, test = "Wilks")
cov.matrix = CalculateMatrix(fit)
write.table(cov.matrix, file = "~/Dropbox/Doc/Output/nolog_vcv/Trachypithecus_germaini.txt", col.names = NA)
